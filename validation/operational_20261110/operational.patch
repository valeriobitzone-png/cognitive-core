+def export_lab_markdown(vault, output):
+    """Inspectable original notes, including explicit withdrawal provenance."""
+    rows=vault.db.execute('''SELECT r.*,b.status batch_status FROM lab_records r JOIN lab_batches b
+        ON b.namespace=r.namespace AND b.id=r.batch_id WHERE r.namespace=? AND r.kind='note' ''',
+        (vault.ns,)).fetchall()
+    for row in rows:
+        header={'id':row['id'],'kind':'lab_note','source_ref':row['source_ref'],
+                'batch_id':row['batch_id'],'batch_status':row['batch_status'],
+                'epistemic':row['epistemic'],'verified':False,'payload_sha256':row['sha256'],
+                'owner':vault.settings.owner,'namespace':vault.settings.namespace}
+        body='---\n'+''.join(k+': '+json.dumps(v,ensure_ascii=False)+'\n' for k,v in header.items())+'---\n\n'
+        body+=json.loads(row['payload'])['text']
+        (output/('lab-'+row['id']+'.md')).write_text(body,encoding='utf-8')
+    return len(rows)
