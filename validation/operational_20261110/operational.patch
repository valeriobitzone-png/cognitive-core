+def search_lab(core, query, limit):
+    terms = re.findall(r'\w+', query)[:12]
+    if not terms:return []
+    where = ' OR '.join('r.payload LIKE ? ESCAPE \'\\\'' for _ in terms)
+    values = ['%'+t.replace('\\','\\\\').replace('_','\\_').replace('%','\\%')+'%' for t in terms]
+    rows = core.vault.db.execute('''SELECT r.* FROM lab_records r JOIN lab_batches b
+        ON b.namespace=r.namespace AND b.id=r.batch_id WHERE r.namespace=? AND b.status='active'
+        AND r.kind NOT IN ('metadata','excluded','archive','quarantine') AND ('''+where+') LIMIT ?',
+        (core.vault.ns,*values,limit)).fetchall()
+    return [{'id':r['id'],'title':r['kind']+' '+r['source_ref'],'excerpt':r['payload'][:500],
+             'source_url':r['source_ref'],'kind':'lab_'+r['kind'],'epistemic':r['epistemic'],
+             'source_sha256':r['sha256'],'batch_id':r['batch_id'],'verified':False} for r in rows]
+
